# Next.js loads this automatically during `next build` (production mode).
# Needed at BUILD time, not just runtime — OpenNext seeds its cache using
# whatever env is present when `next build` runs locally, before Wrangler's
# `vars` in wrangler.jsonc ever apply. Without this, metadata routes like
# sitemap.ts/robots.ts silently bake in http://localhost:3000 forever.
NEXT_PUBLIC_SITE_URL=https://makeinmotion.com
