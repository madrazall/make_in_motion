# Copy to .env.local for development. Never commit .env.local.
# In production these live in Cloudflare via `wrangler secret put NAME`.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_TIMEZONE=America/New_York

# --- Supabase ---
# Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key bypasses row-level security. Server-side only. Never expose.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Stripe ---
# Use sk_test_... until launch day.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the Dashboard webhook endpoint in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Resend ---
RESEND_API_KEY=re_...
# Must be a verified domain address. A @gmail.com sender will fail DMARC. See PLAN-v2.md §21.
EMAIL_FROM="Make In Motion <hello@makeinmotion.com>"
EMAIL_REPLY_TO=makeinmotionct@gmail.com

# --- Admin ---
# Single admin login.
ADMIN_PASSWORD=change-me-to-something-long
# Random string used to sign the admin session cookie.
SESSION_SECRET=generate-with-openssl-rand-hex-32

# --- Cron ---
# Shared secret so nothing but the scheduled worker can hit /api/cron/*
CRON_SECRET=generate-with-openssl-rand-hex-32
